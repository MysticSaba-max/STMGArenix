PORT=3001
JWT_SECRET=change-me-in-production-use-random-string

# Compte admin par défaut (utilisé par npm run seed)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin123

# Base de données MySQL — remplis avec tes infos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=stmgarenix

# Cloudflare Turnstile (laisser vide en dev)
TURNSTILE_SECRET_KEY=

# Origine autorisée (laisser vide en dev)
ALLOWED_ORIGIN=

# Clés API vpnapi.io pour la détection VPN/proxy (séparées par des virgules)
# Créer un compte sur https://vpnapi.io pour obtenir des clés
VPN_API_KEYS=
